void gaussSeidel(float A[3][3], int b[3], float c[3], float lambda, float es)
{
  const int max_iter = 500;
  float x_old[3] = {0, 0, 0};  // initial guess
  float x_new[3] = {0, 0, 0};

  for (int iter = 0; iter < max_iter; iter++) {
    for (int i = 0; i < 3; i++) {
      float sum = 0;

      //x_new[i] = (1 - lambda) * x_old[i] + ( (b[i] - sum) / A[i][i] );
      x_new[1] = (b[1] - A[1][2] * x_new[2] - A[1][3]*x_new[3]) / A[1][1];
      x_new[2] = (b[2] - A[2][1] * x_new[1] - A[2][3]*x_new[3]) / A[2][2];
      x_new[3] = (b[3] - A[3][1] * x_new[1] - A[3][2]*x_new[2]) / A[3][3];
    }

    // Compute approximate relative error
    float max_error = 0;
    for (int i = 0; i < 3; i++) {
      float denom = (abs(x_new[i]) > 1e-6) ? abs(x_new[i]) : 1e-6;  // avoid division by zero
      float ea = abs((x_new[i] - x_old[i]) / denom) * 100;
      if (ea > max_error) {
        max_error = ea;
      }
      x_old[i] = x_new[i];  // update for next iteration
    }

    if (max_error < es) {
      break;
    }
  }

  // Copy result into c array
  for (int i = 0; i < 3; i++) {
    c[i] = x_new[i];
  }
}
